{:paths ["bb"]
 :bb-transient/cljbang-paths ["emacs"]
 :bb-transient/defaults {:a (el/org-entry-get nil "ID" true)
                         :b (el/error "Boom")
                         :name (el/buffer-name)}
 :tasks
 {zeta {:doc "Listed first, so order is file order"
        :task (println "zeta")}

  greet
  {:doc "Greeting commands"
   :cmd {"hello" {:exec-fn cmds/hello}
         "nested" {:cmd {"deep" {:exec-fn cmds/deep}}}}}

  echo {:doc "Echo its options" :exec-fn cmds/echo}

  broken {:doc "Points at a missing fn" :exec-fn cmds/nope}

  table {:doc "A :cmd held in a var" :cmd cmds/table}

  tui {:doc "Commands that want a terminal"
       :cmd {"top" {:exec-fn cmds/top}
             "watch" {:bb-transient/terminal true
                    :bb-transient/defaults {:a (el/buffer-name)}
                    :exec-fn cmds/echo}
             "plain" {:exec-fn cmds/deep}}}

  hooks {:doc "Commands with before and after hooks"
         :cmd {"rewrite" {:exec-fn cmds/echo
                          :bb-transient/before (fn [{:keys [args]}] (conj args "--b=added"))}
               "refuse" {:exec-fn cmds/echo
                         :bb-transient/before (fn [_] (throw (ex-info "Not today" {})))}
               "record" {:exec-fn cmds/fail}}}

  noted {:doc "A plain task with a hook"
         :task (println "noted")
         :bb-transient/after fixture.hooks/record}

  -hidden {:task (println "private by name")}
  secret {:private true :task (println "private by flag")}}}
