{:forge/parent "atomstream/forge"
 :paths ["user"]
 :tasks
 {:init (do (def emacs (or (System/getenv "EMACS") "emacs"))
            ;; cljbang's directory; without it the cljbang tests skip
            (def cljbang (System/getenv "CLJBANG")))

  test {:doc "Run the ERT suite (set CLJBANG to cljbang's directory to test defaults)"
        :task (apply shell emacs "--batch" "-L" "." "-L" "test"
                     (concat (when cljbang ["-L" cljbang])
                             ["-l" "ert" "-l" "test/bb-transient-test.el"
                              "-f" "ert-run-tests-batch-and-exit"]))}

  compile {:doc "Byte-compile"
           :task (shell emacs "--batch" "-L" "."
                        "--eval" "(setq byte-compile-error-on-warn t)"
                        "-f" "batch-byte-compile" "bb-transient.el")}

  ci {:doc "What CI runs"
      :depends [compile test]}

  demo {:doc "Demo time!"
        :cmd {:greet {:exec-fn demo/greet}}}}}
