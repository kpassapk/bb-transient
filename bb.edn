{:forge/parent "atomstream/forge"
 :paths ["user"]
 :tasks
 {:init (do (def emacs (or (System/getenv "EMACS") "emacs"))
            ;; cljbang's directory; without it the cljbang tests skip
            (def cljbang (System/getenv "CLJBANG")))

  test {:doc "Run the ERT suite (set CLJBANG to cljbang's directory to test defaults)"
        :task (apply shell emacs "--batch" "-L" "." "-L" "test"
                     (concat (when cljbang ["-L" cljbang])
                             ["-l" "ert" "-l" "test/bb-transient-test.el"
                              "-f" "ert-run-tests-batch-and-exit"]))}

  ;; Only a check: it leaves no .elc, pass or fail.  Emacsen that load
  ;; bb-transient from this checkout would otherwise pick up a stale one.
  compile {:doc "Byte-compile (warnings are errors; leaves no .elc)"
           :requires ([babashka.fs :as fs])
           :task (let [{:keys [exit]} (shell {:continue true} emacs "--batch" "-L" "."
                                             "--eval" "(setq byte-compile-error-on-warn t)"
                                             "-f" "batch-byte-compile" "bb-transient.el")]
                   (fs/delete-if-exists "bb-transient.elc")
                   (when-not (zero? exit) (System/exit exit)))}

  ci {:doc "What CI runs"
      :depends [compile test]}

  demo {:doc "Demo time!"
        :cmd {:greet {:exec-fn demo/greet}
              :tetris {:exec-fn demo/tetris
                       :bb-transient/silent true
                       :bb-transient/after (fn [{:keys [exit]}]
                                             (when (zero? exit) (el/tetris)))}}}}}
